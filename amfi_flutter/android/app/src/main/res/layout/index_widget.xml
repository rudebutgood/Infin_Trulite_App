<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:clickable="false">

    <!-- Header with Indigo Gradient -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:background="@drawable/header_background"
        android:clickable="true">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Infin Watchlist"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:clickable="false" />

        <TextView
            android:id="@+id/last_refresh_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Updated: "
            android:textColor="#CCFFFFFF"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/last_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#CCFFFFFF"
            android:textSize="8sp"
            android:layout_marginRight="6dp" />

        <TextView
            android:id="@+id/btn_toggle_cols"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold"
            android:background="#33FFFFFF"
            android:padding="3dp"
            android:layout_marginRight="8dp"
            android:clickable="true" />

        <FrameLayout
            android:id="@+id/logo_refresh_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:clickable="true">

            <ImageView
                android:id="@+id/widget_logo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@mipmap/ic_launcher" />

            <ProgressBar
                android:id="@+id/refresh_progress"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:indeterminate="true"
                android:indeterminateTint="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clickable="false">

        <TextView
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="No bookmarks.\nOpen app to add."
            android:textColor="#9E9E9E"
            android:textSize="11sp"
            android:visibility="gone" />

        <GridView
            android:id="@+id/indices_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="2"
            android:verticalSpacing="4dp"
            android:horizontalSpacing="8dp"
            android:stretchMode="columnWidth"
            android:gravity="center" />
    </FrameLayout>

</LinearLayout>
